      "get": {
        "tags": [
          "Phones"
        ],
        "summary": "Get All Phones",
        "parameters": [
          {
            "name": "brand_id",
            "in": "query",
            "required": false,
            "description": "Filter by Brand ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by status: DRAFT, PUBLISHED, ARCHIVED",
            "schema": {
              "type": "string",
              "example": "PUBLISHED"
            }
          },
          {
            "name": "phone_condition",
            "in": "query",
            "required": false,
            "description": "Filter by condition: NEW, USED",
            "schema": {
              "type": "string",
              "example": "NEW"
            }
          },
          {
            "name": "availability",
            "in": "query",
            "required": false,
            "description": "Filter by availability: IN_STOCK, LOW_STOCK, SOLD_OUT, COMING_SOON",
            "schema": {
              "type": "string",
              "example": "IN_STOCK"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search keyword in phone name or brand name",
            "schema": {
              "type": "string",
              "example": "iPhone"
            }
          },
          {
            "name": "archived",
            "in": "query",
            "description": "Filter by archived status: yes / true / 1 for archived only; no / false for normal only; all for both",
            "schema": {
              "type": "string",
              "example": "yes"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of phones",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "count": 1,
                  "data": [
                    {
                      "phone_id": 1,
