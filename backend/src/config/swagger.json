                      "colour_options": ["Natural Titanium", "Blue Titanium"],
                      "stock_quantity": 25,
                      "availability": "IN_STOCK",
                      "status": "PUBLISHED",
                      "created_at": "2026-10-14T05:30:00.000Z"
                    }
                  ]
                }
              }
            }
          }
        }
      }
