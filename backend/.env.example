# Server Port
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Aiven / Local)
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=11302
DB_USER=avnadmin
DB_PASSWORD=your_secure_db_password
DB_NAME=defaultdb
DB_CONNECTION_LIMIT=10

# TLS / SSL Certificate Configuration for Database
# Set DB_SSL=false for non-SSL local databases.
DB_SSL=true
# Set DB_SSL_REJECT_UNAUTHORIZED=true in production.
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional path to Aiven CA Certificate (ca.pem) for full verification in production:
# DB_SSL_CA_PATH=/path/to/ca.pem

# Allowed CORS Origins (comma-separated, without trailing slashes)
# Must explicitly match the admin dashboard and public website domains
ALLOWED_ORIGINS=https://admin.sklabaphone.com,https://sklabaphone.com,http://localhost:5173,http://localhost:3000

# Session Configuration
# Mandatory random string of at least 32 characters in production
SESSION_SECRET=change-this-to-a-cryptographically-secure-random-string-min-32-chars
SESSION_COOKIE_NAME=sk_laba_sid
# Session expiration in milliseconds (default: 86400000 = 24 hours)
SESSION_MAX_AGE_MS=86400000
# Cookie security settings
# Set COOKIE_SECURE=true when running over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Scoped cookie domain (e.g. .sklabaphone.com for subdomains, or leave empty for host-only)
# COOKIE_DOMAIN=.sklabaphone.com
# Session store: 'mysql' (default) or 'memory' (for isolated testing)
SESSION_STORE=mysql

# Rate Limiting for Authentication
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX=10

# SMTP Configuration for Transactional Emails (Password Reset)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="SK LABA PHONE" <no-reply@sklabaphone.com>

# Password Reset URL Configuration
# Strictly configured frontend base URL used to construct reset links (never uses Host header)
PASSWORD_RESET_BASE_URL=https://admin.sklabaphone.com
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15
